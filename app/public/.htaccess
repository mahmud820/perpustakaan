# ===========================
# BASIC SECURITY OPTIONS
# ===========================
Options -Indexes
Options -Multiviews

# ===========================
# SECURITY HEADERS
# (mitigasi tambahan untuk clickjacking, MIME sniffing, kebocoran referrer)
# "always" = header ikut terkirim pada halaman error (403/404/500), bukan hanya 2xx
# ===========================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ===========================
# CONTENT SECURITY POLICY (mode LAPOR SAJA, belum memblokir apa pun)
# Pelanggaran hanya muncul sebagai peringatan merah di Console browser (F12).
# Setelah semua halaman bersih dari peringatan, ganti nama header menjadi
# "Content-Security-Policy" (hapus "-Report-Only") untuk benar-benar memberlakukan.
# Catatan:
# - 'self' = origin yang sama dengan halaman. Buka situs lewat BASEURL (perpustakaan.local),
#   bukan localhost, supaya gambar/skrip dianggap 'self'.
# - style-src 'unsafe-inline' dibutuhkan: SweetAlert2 menyisipkan <style> sendiri dan
#   banyak view memakai atribut style="...".
# - img-src data: dibutuhkan ikon hamburger Bootstrap (SVG data-URI).
# ===========================
<IfModule mod_headers.c>
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ===========================
# ENABLE REWRITE
# ===========================
RewriteEngine On

# ===========================
# FOLDER FILE STATIS: jangan diteruskan ke router MVC
# (file yang tidak ada dibalas 404 oleh Apache, bukan halaman aplikasi)
# ===========================
RewriteCond %{REQUEST_URI} !^/(js|css|img|uploads|fonts|vendor)/

# ===========================
# ROUTING FOR MVC
# ===========================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
