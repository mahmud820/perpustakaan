# Cegah eksekusi PHP/CGI di folder upload dokumen (PDF).
# Defense in depth di atas validasi MIME + magic bytes %PDF- yang sudah dilakukan aplikasi.
# Sama dengan pengaman di img/dataGambar/ dan img/profil/.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
